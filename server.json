{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.ameyxd/petromcp",
  "title": "petromcp",
  "description": "Local-first MCP server for petroleum data. Reads LAS well logs and DLIS files behind a default-deny path allowlist: structure, per-curve statistics, channel values, well comparison, and unit conversion.",
  "version": "0.7.0",
  "repository": {
    "url": "https://github.com/ameyxd/petromcp",
    "source": "github"
  },
  "websiteUrl": "https://github.com/ameyxd/petromcp",
  "packages": [
    {
      "registryType": "pypi",
      "registryBaseUrl": "https://pypi.org",
      "identifier": "petroleum-mcp",
      "version": "0.7.0",
      "runtimeHint": "uvx",
      "transport": {
        "type": "stdio"
      },
      "runtimeArguments": [
        {
          "type": "positional",
          "value": "serve",
          "description": "Run the stdio MCP server.",
          "isRequired": true
        }
      ]
    }
  ]
}
